#!/bin/bash
#SBATCH --output <jobname>-<run>-equil.out
#SBATCH --job-name <jobname>-<run>-equil
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=2
#SBATCH --gpus=1
#SBATCH -t 48:00:00
#SBATCH -p <qname>
#SBATCH -A <account>
#SBATCH --mail-type=ALL
#SBATCH --mail-user=<email>

qname=<qname>
account=<account>
email=<email>
sysname=<sysname>
drudedir=<drudedir>
run=<run>

module purge                                                    
module load slurm                                               
module load shared                                              
module load gpu/0.15.4                                          
module load cuda10.2/toolkit/10.2.89                            
module load anaconda3/2020.11  

# Activate my Conda Enviroment with openMM+plumed
source activate /expanse/lustre/projects/vpt121/jalemkul/software/env/openmm7.7.0  

echo "Python loaded:"
which python

# Change to the directory from which the job was submitted
cd $SLURM_SUBMIT_DIR

# ONLY needed if you are using more than one gpu
#echo "Total visible devices:"
#echo $CUDA_VISIBLE_DEVICES

# Run simulation
#export CUDA_VISIBLE_DEVICES=0

for j in {10..100..10}; do
    if cd ${drudedir}/${run}/${j}/equil ; then
        python ${SILCSBIODIR}/drude_silcs/scripts/EquNPT_drude.py \
            -psf ${sysname}.drude.silcs.xplor.psf \
            -pdb ${sysname}.silcs.min.drude.pdb \
            -toppar ${drudedir}/toppar_drude_silcs_openmm.str \
            -restraint_file restraint_atoms.dat \
            -state_c36 ${sysname}_boxsize.rst \
            -runtime 1000 \
            -dt 1 \
            -savefreq 10 \
            -printfreq 10 \
            -outname ${sysname}.${run}.drude.silcs.${j}.npt > EquNPT_drude_${run}_${j}.log 
    else 
        echo "${drudedir}/${run}/${j}/equil does not exist; please check your script and try again"
    fi
done 


